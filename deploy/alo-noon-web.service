; The customer site and the admin panel — one Next.js server.
;
; Built with `output: 'standalone'`, so what runs is the copied server under
; .next/standalone rather than the workspace. That directory carries its own
; node_modules, which is why this unit does not need the repository's.
;
; Install: copy to /etc/systemd/system/, then
;   systemctl daemon-reload && systemctl enable --now alo-noon-web

[Unit]
Description=Alo Noon web
Documentation=https://github.com/tecpey/---Alo-Noon
; Ordering only, and deliberately not Requires=: the site should come up and
; render its error states even when the API is down. A storefront that refuses
; to load tells a customer nothing; one that loads and says "we cannot take
; orders right now" tells them what they need to know.
After=network-online.target alo-noon-api.service
Wants=network-online.target

; In [Unit], not [Service] — systemd ignores these under [Service] silently.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=alo-noon
Group=alo-noon
WorkingDirectory=/srv/alo-noon/current/apps/web/.next/standalone/apps/web
EnvironmentFile=/etc/alo-noon/web.env
ExecStart=/usr/bin/node server.js
; The image optimiser's cache, and the one path this service writes. Under
; ProtectSystem=strict the release is read-only, so without this every product
; photograph was re-encoded on every request and each one logged EACCES.
; systemd creates /var/cache/alo-noon-web owned by the service user and keeps it
; writable; deploy/stage-web.sh links .next/cache to it.
CacheDirectory=alo-noon-web

KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
; Further confinement, from `systemd-analyze security` (6.2 MEDIUM before).
; Only what a Node service is known to tolerate: no capabilities (the user is
; unprivileged anyway, so this states it rather than relies on it), no device
; nodes beyond /dev/null, /dev/urandom and friends, no clock, hostname or kernel
; log access, other users' processes invisible, and syscalls limited to the set
; systemd curates for ordinary services — refused with EPERM rather than a kill,
; so a surprise shows up as an error in the journal, not a crash loop.
; Deliberately absent: MemoryDenyWriteExecute (V8's JIT needs W+X pages) and
; ProcSubset=pid (hides /proc/cpuinfo and /proc/meminfo, which os.cpus() and
; os.totalmem() read).
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alo-noon-web

[Install]
WantedBy=multi-user.target
