    "@alo-noon/domain": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.69.0",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@alo-noon/eslint-config": "workspace:*",
    "@alo-noon/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9.24.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
