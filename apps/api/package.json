{
  "name": "@alo-noon/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/bundle.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
