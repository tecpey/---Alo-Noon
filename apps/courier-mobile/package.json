{
  "name": "@alo-noon/courier-mobile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "build": "expo export --platform web --output-dir dist",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .expo coverage"
  },
  "dependencies": {
    "@alo-noon/contracts": "workspace:*",
    "@alo-noon/design-tokens": "workspace:*",
    "@alo-noon/domain": "workspace:*",
    "@alo-noon/mobile-ui": "workspace:*",
    "@expo/metro-runtime": "57.0.7",
    "expo": "57.0.8",
    "expo-blur": "^57.0.2",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@alo-noon/eslint-config": "workspace:*",
    "@types/react": "^19.2.0",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
