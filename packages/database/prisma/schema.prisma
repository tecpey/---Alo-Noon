generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  IRR
}

enum CustomerLifecycleStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum HouseholdMemberRole {
  OWNER
  ADULT
  DEPENDENT
  RECIPIENT
}

enum AddressVerificationState {
  UNVERIFIED
  CUSTOMER_CONFIRMED
  OPERATIONS_VERIFIED
  REJECTED
}

enum BakeryPartnerStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum BranchOperationalStatus {
  ONBOARDING
  ACTIVE
  TEMPORARILY_SUSPENDED
  CLOSED
}

enum QualityStatus {
  PENDING_REVIEW
  APPROVED
  WATCHLIST
  SUSPENDED
}

enum ProductFulfillmentClass {
  SIGNATURE_FRESH
  PACKAGED_TRADITIONAL
  PACKAGED_FANTASY
  PACKAGED_DIETARY
  LIMITED_EDITION
}

enum FreshnessClaim {
  FRESHLY_PRODUCED
  PACKAGED
  SHELF_STABLE
  NONE
}

enum ProductionMode {
  MADE_TO_ORDER
  SCHEDULED_BATCH
  READY_STOCK
  EXTERNAL_PACKAGED_SUPPLY
}

enum FulfillmentControl {
  CONTROLLED_PICKUP
  PARTNER_HANDOFF
  PLATFORM_STOCK
  THIRD_PARTY_SUPPLY
}

enum PackagingType {
  ALO_NOON_SEALED
  PARTNER_SEALED
  MANUFACTURER_PACKAGED
}

enum ProductLifecycleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

enum OfferingAvailabilityStatus {
  DRAFT
  AVAILABLE
  PAUSED
  SOLD_OUT
  RETIRED
}

enum OrderState {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  IN_FULFILLMENT
  CANCEL_REQUESTED
  DELIVERY_FAILED
  COMPLETED
  CANCELLED
}

enum PaymentState {
  NOT_STARTED
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
}

enum ProductionState {
  NOT_REQUIRED
  UNSCHEDULED
  SCHEDULED
  IN_PRODUCTION
  READY
  HANDED_OFF
}

enum DeliveryState {
  NOT_REQUIRED
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ActorType {
  CUSTOMER
  STAFF
  BAKERY
  COURIER
  SYSTEM
}

enum FulfillmentType {
  BAKERY_PICKUP_DELIVERY
  PLATFORM_STOCK_DELIVERY
  CUSTOMER_PICKUP
}

enum FulfillmentState {
  PLANNED
  PREPARING
  READY
  HANDED_OFF
  COMPLETED
  FAILED
  CANCELLED
}

enum CourierStatus {
  ONBOARDING
  AVAILABLE
  UNAVAILABLE
  SUSPENDED
  OFFBOARDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  ELECTRIC_MOTORCYCLE
  CAR
  VAN
  ON_FOOT
}

enum VehicleStatus {
  PENDING_REVIEW
  ACTIVE
  MAINTENANCE
  SUSPENDED
  RETIRED
}

enum DeliveryTaskState {
  UNASSIGNED
  ASSIGNMENT_PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryAssignmentState {
  OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EventPurpose {
  DOMAIN
  AUDIT
  ENGAGEMENT
}

enum ConsentBasis {
  NOT_REQUIRED
  TRANSACTIONAL
  EXPLICIT_CONSENT
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IncidentStatus {
  OPEN
  MITIGATING
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IdentityAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OtpChallengeStatus {
  PENDING
  CONSUMED
  INVALIDATED
}

enum AuthorizationScopeType {
  GLOBAL
  CITY
  OPERATIONAL_ZONE
  BAKERY_BRANCH
  COURIER_PARTNER
  SELF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TenantMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CartState {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum QuoteStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  ACCEPTED
}

enum DeliveryPricingCalculationMode {
  FLAT
  DISTANCE_BANDED
}

model Tenant {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(64)
  name           String
  status         TenantStatus       @default(ACTIVE)
  defaultLocale  String             @default("fa-IR") @db.VarChar(16)
  currency       Currency           @default(IRR)
  domains        TenantDomain[]
  memberships    TenantMembership[]
  activeSessions AuthSession[]
  deliveryPricingRules DeliveryPricingRule[]
  aiAuditEvents  AiControlPlaneAuditEvent[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
}

model TenantDomain {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host       String   @unique @db.VarChar(253)
  isPrimary  Boolean  @default(false)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, isPrimary])
}

model TenantMembership {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @db.Uuid
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId   String                 @db.Uuid
  account     IdentityAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status      TenantMembershipStatus @default(INVITED)
  activeAt    DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, accountId])
  @@index([accountId, status])
  @@index([tenantId, status])
}

model City {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  code             String            @unique @db.VarChar(32)
  nameFa           String
  timezone         String            @default("Asia/Tehran") @db.VarChar(64)
  isActive         Boolean           @default(false)
  operationalZones OperationalZone[]
  addresses        Address[]
  bakeryBranches   BakeryBranch[]
  carts            Cart[]
  orders           Order[]
  deliveryPricingRules DeliveryPricingRule[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_City_id_tenant_key")
}

model OperationalZone {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  cityId         String         @db.Uuid
  city           City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  code           String         @db.VarChar(32)
  nameFa         String
  isActive       Boolean        @default(false)
  serviceAreas   ServiceArea[]
  addresses      Address[]
  bakeryBranches BakeryBranch[]
  orders         Order[]
  carts          Cart[]
  deliveryPricingRules DeliveryPricingRule[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([cityId, code])
  @@index([cityId, isActive])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_OperationalZone_id_tenant_key")
  @@index([cityId, tenantId], map: "g3b_OperationalZone_cityId_tenant_idx")
}

model ServiceArea {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  operationalZoneId String          @db.Uuid
  operationalZone   OperationalZone @relation(fields: [operationalZoneId], references: [id], onDelete: Cascade)
  code              String          @db.VarChar(32)
  nameFa            String
  boundaryGeoJson   Json
  isActive          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([operationalZoneId, code])
  @@index([operationalZoneId, isActive])

  @@index([tenantId])

  @@index([operationalZoneId, tenantId], map: "g3b_ServiceArea_operationalZoneId_tenant_idx")
}

model Customer {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  mobileE164             String                  @unique @db.VarChar(16)
  firstName              String?
  lastName               String?
  lifecycleStatus        CustomerLifecycleStatus @default(PROSPECT)
  crmProfileRef          String?                 @unique @db.VarChar(128)
  transactionalConsentAt DateTime?
  marketingConsentAt     DateTime?
  marketingOptOutAt      DateTime?
  householdMemberships   HouseholdMember[]
  addresses              Address[]
  orders                 Order[]
  customerEvents         CustomerEvent[]
  supportCases           SupportCase[]
  identityAccount        IdentityAccount?
  carts                  Cart[]
  quotes                 Quote[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([lifecycleStatus, createdAt])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_Customer_id_tenant_key")
}

model IdentityAccount {
  id           String                @id @default(uuid()) @db.Uuid
  mobileE164   String                @unique @db.VarChar(16)
  customerId   String?               @unique @db.Uuid
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status       IdentityAccountStatus @default(ACTIVE)
  verifiedAt   DateTime?
  sessions     AuthSession[]
  accessGrants AccessGrant[]
  tenantMemberships TenantMembership[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
}

model OtpChallenge {
  id                String             @id @default(uuid()) @db.Uuid
  mobileE164        String             @db.VarChar(16)
  codeDigest        String             @db.VarChar(64)
  status            OtpChallengeStatus @default(PENDING)
  attempts          Int                @default(0)
  maxAttempts       Int                @default(5)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime           @default(now())

  @@index([mobileE164, createdAt])
  @@index([status, expiresAt])
}

model AuthSession {
  id          String          @id @default(uuid()) @db.Uuid
  accountId   String          @db.Uuid
  account     IdentityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activeTenantId String         @db.Uuid
  activeTenant   Tenant         @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)
  tokenDigest String          @unique @db.VarChar(64)
  expiresAt   DateTime
  lastSeenAt  DateTime
  revokedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([accountId, revokedAt, expiresAt])
}

model AuthorizationRole {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String
  permissions RolePermission[]
  grants      AccessGrant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model AuthorizationPermission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String                  @db.Uuid
  role         AuthorizationRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String                  @db.Uuid
  permission   AuthorizationPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AccessGrant {
  id        String                 @id @default(uuid()) @db.Uuid
  accountId String                 @db.Uuid
  account   IdentityAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roleId    String                 @db.Uuid
  role      AuthorizationRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType AuthorizationScopeType
  scopeId   String?                @db.Uuid
  activeAt  DateTime               @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([accountId, revokedAt, expiresAt])
  @@index([scopeType, scopeId])
}

model Household {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  name      String
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_Household_id_tenant_key")
}

model HouseholdMember {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  householdId String              @db.Uuid
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  customerId  String?             @db.Uuid
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  displayName String
  mobileE164  String?             @db.VarChar(16)
  role        HouseholdMemberRole
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([householdId, customerId])
  @@index([householdId, role])

  @@index([tenantId])

  @@index([householdId, tenantId], map: "g3b_HouseholdMember_householdId_tenant_idx")
  @@index([customerId, tenantId], map: "g3b_HouseholdMember_customerId_tenant_idx")
}

model Address {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  customerId           String                   @db.Uuid
  customer             Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cityId               String                   @db.Uuid
  city                 City                     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  operationalZoneId    String?                  @db.Uuid
  operationalZone      OperationalZone?         @relation(fields: [operationalZoneId], references: [id], onDelete: SetNull)
  label                String
  recipientName        String
  recipientPhoneE164   String                   @db.VarChar(16)
  addressLine          String
  postalCode           String?                  @db.VarChar(10)
  latitude             Decimal                  @db.Decimal(10, 7)
  longitude            Decimal                  @db.Decimal(10, 7)
  deliveryInstructions String?
  verificationState    AddressVerificationState @default(UNVERIFIED)
  verifiedAt           DateTime?
  archivedAt           DateTime?
  orders               Order[]
  quotes               Quote[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([customerId, archivedAt])
  @@index([cityId, operationalZoneId, verificationState])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_Address_id_tenant_key")
  @@index([customerId, tenantId], map: "g3b_Address_customerId_tenant_idx")
  @@index([cityId, tenantId], map: "g3b_Address_cityId_tenant_idx")
  @@index([operationalZoneId, tenantId], map: "g3b_Address_operationalZoneId_tenant_idx")
}

model Bakery {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  legalName     String
  displayNameFa String
  partnerStatus BakeryPartnerStatus @default(PROSPECT)
  agreementRef  String?             @unique @db.VarChar(128)
  branches      BakeryBranch[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([partnerStatus])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_Bakery_id_tenant_key")
}

model BakeryBranch {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  bakeryId           String                  @db.Uuid
  bakery             Bakery                  @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  cityId             String                  @db.Uuid
  city               City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  operationalZoneId  String                  @db.Uuid
  operationalZone    OperationalZone         @relation(fields: [operationalZoneId], references: [id], onDelete: Restrict)
  code               String                  @db.VarChar(32)
  nameFa             String
  addressLine        String
  latitude           Decimal                 @db.Decimal(10, 7)
  longitude          Decimal                 @db.Decimal(10, 7)
  pickupInstructions String?
  operationalStatus  BranchOperationalStatus @default(ONBOARDING)
  qualityStatus      QualityStatus           @default(PENDING_REVIEW)
  suspendedUntil     DateTime?
  suspensionReason   String?
  operatingHours     BakeryOperatingHours[]
  capacitySlots      BakeryCapacitySlot[]
  offerings          BakeryProductOffering[]
  orders             Order[]
  fulfillments       Fulfillment[]
  carts              Cart[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([cityId, code])
  @@index([operationalZoneId, operationalStatus, qualityStatus])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_BakeryBranch_id_tenant_key")
  @@index([bakeryId, tenantId], map: "g3b_BakeryBranch_bakeryId_tenant_idx")
  @@index([cityId, tenantId], map: "g3b_BakeryBranch_cityId_tenant_idx")
  @@index([operationalZoneId, tenantId], map: "g3b_BakeryBranch_operationalZoneId_tenant_idx")
}

model BakeryOperatingHours {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  bakeryBranchId String       @db.Uuid
  bakeryBranch   BakeryBranch @relation(fields: [bakeryBranchId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  opensAtMinute  Int
  closesAtMinute Int
  isClosed       Boolean      @default(false)

  @@unique([bakeryBranchId, dayOfWeek])

  @@index([tenantId])

  @@index([bakeryBranchId, tenantId], map: "g3b_BakeryOperatingHours_bakeryBranchId_tenant_idx")
}

model BakeryCapacitySlot {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  bakeryBranchId String       @db.Uuid
  bakeryBranch   BakeryBranch @relation(fields: [bakeryBranchId], references: [id], onDelete: Cascade)
  serviceDate    DateTime     @db.Date
  maxOrders      Int
  reservedOrders Int          @default(0)
  suspended      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([bakeryBranchId, serviceDate])

  @@index([tenantId])

  @@index([bakeryBranchId, tenantId], map: "g3b_BakeryCapacitySlot_bakeryBranchId_tenant_idx")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  code      String    @unique @db.VarChar(32)
  nameFa    String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_ProductCategory_id_tenant_key")
}

model Product {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  categoryId    String                 @db.Uuid
  category      ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug          String                 @unique @db.VarChar(100)
  nameFa        String
  descriptionFa String?
  mediaRef      String?                @db.VarChar(500)
  lifecycle     ProductLifecycleStatus @default(DRAFT)
  variants      ProductVariant[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([categoryId, lifecycle])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_Product_id_tenant_key")
  @@index([categoryId, tenantId], map: "g3b_Product_categoryId_tenant_idx")
}

model ProductVariant {
  id                      String                  @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  productId               String                  @db.Uuid
  product                 Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku                     String                  @unique @db.VarChar(64)
  nameFa                  String
  fulfillmentClass        ProductFulfillmentClass
  freshnessClaim          FreshnessClaim
  productionMode          ProductionMode
  fulfillmentControl      FulfillmentControl
  packagingType           PackagingType?
  shelfLifeMinutes        Int?
  productionWindowMinutes Int?
  pickupWithinMinutes     Int?
  freshnessWindowMinutes  Int?
  ingredients             String[]
  allergens               String[]
  dietaryAttributes       String[]
  lifecycle               ProductLifecycleStatus  @default(DRAFT)
  offerings               BakeryProductOffering[]
  orderItems              OrderItem[]
  quoteItems              QuoteItem[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([fulfillmentClass, lifecycle])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_ProductVariant_id_tenant_key")
  @@index([productId, tenantId], map: "g3b_ProductVariant_productId_tenant_idx")
}

model BakeryProductOffering {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  bakeryBranchId     String                     @db.Uuid
  bakeryBranch       BakeryBranch               @relation(fields: [bakeryBranchId], references: [id], onDelete: Restrict)
  productVariantId   String                     @db.Uuid
  productVariant     ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  priceAmount        BigInt
  priceCurrency      Currency                   @default(IRR)
  availability       OfferingAvailabilityStatus @default(DRAFT)
  dailyCapacity      Int?
  preparationMinutes Int?
  availableFrom      DateTime?
  availableUntil     DateTime?
  orderItems         OrderItem[]
  cartItems          CartItem[]
  quoteItems         QuoteItem[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([bakeryBranchId, productVariantId])
  @@index([bakeryBranchId, availability])

  @@index([tenantId])

  @@unique([id, tenantId], map: "g3b_BakeryProductOffering_id_tenant_key")
  @@index([bakeryBranchId, tenantId], map: "g3b_BakeryProductOffering_bakeryBranchId_tenant_idx")
  @@index([productVariantId, tenantId], map: "g3b_BakeryProductOffering_productVariantId_tenant_idx")
}

model DeliveryPricingRule {
  id                    String                         @id @default(uuid()) @db.Uuid
  tenantId              String                         @db.Uuid
  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cityId                String                         @db.Uuid
  city                  City                           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  operationalZoneId     String?                        @db.Uuid
  operationalZone       OperationalZone?               @relation(fields: [operationalZoneId], references: [id], onDelete: Restrict)
  version               Int
  calculationMode       DeliveryPricingCalculationMode @default(FLAT)
  baseFeeAmount         BigInt
  perKilometerFeeAmount BigInt                          @default(0)
  minimumOrderAmount    BigInt?
  freeDeliveryThreshold BigInt?
  currency              Currency                       @default(IRR)
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  isActive              Boolean                        @default(false)
  quotes                Quote[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([tenantId, cityId, operationalZoneId, version], map: "DeliveryPricingRule_scope_version_key")
  @@unique([id, tenantId], map: "g3b_DeliveryPricingRule_id_tenant_key")
  @@index([tenantId, cityId, operationalZoneId, isActive, effectiveFrom], map: "DeliveryPricingRule_active_scope_idx")
  @@index([cityId, tenantId], map: "g3b_DeliveryPricingRule_cityId_tenant_idx")
