model BakeryBranch {
  id                        String                  @id @default(uuid()) @db.Uuid
  tenantId                  String                  @db.Uuid
  bakeryId                  String                  @db.Uuid
  bakery                    Bakery                  @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  cityId                    String                  @db.Uuid
  city                      City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  operationalZoneId         String                  @db.Uuid
  operationalZone           OperationalZone         @relation(fields: [operationalZoneId], references: [id], onDelete: Restrict)
  code                      String                  @db.VarChar(32)
  nameFa                    String
  addressLine               String
  latitude                  Decimal                 @db.Decimal(10, 7)
  longitude                 Decimal                 @db.Decimal(10, 7)
  pickupInstructions        String?
  operationalStatus         BranchOperationalStatus @default(ONBOARDING)
  qualityStatus             QualityStatus           @default(PENDING_REVIEW)
  suspendedUntil            DateTime?
  suspensionReason          String?
  /// How the branch cuts its opening hours into bookable delivery windows.
  /// Held on the branch rather than globally because a bakery that bakes every
  /// two hours and one that bakes twice a day cannot promise the same thing.
  deliveryWindowMinutes     Int                     @default(120)
  /// How long before a window opens the branch stops taking orders for it.
  /// This is the dough, not the drive.
  deliveryLeadTimeMinutes   Int                     @default(90)
  /// How many days ahead a customer may book. Zero means today only.
  deliveryWindowHorizonDays Int                     @default(1)
  /// How many orders one window may hold. A bakery that can do two hundred
  /// loaves a day cannot get forty of them out of the oven between seven and
  /// eight, and a day-level cap alone cannot say that.
  deliveryWindowMaxOrders   Int                     @default(20)
  operatingHours            BakeryOperatingHours[]
  capacitySlots             BakeryCapacitySlot[]
  deliveryWindows           BakeryDeliveryWindow[]
  offerings                 BakeryProductOffering[]
  orders                    Order[]
  fulfillments              Fulfillment[]
  carts                     Cart[]
  routeEstimates            RouteEstimate[]
  deliveryTrips             DeliveryTrip[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([cityId, code])
  @@unique([id, tenantId], map: "g3b_BakeryBranch_id_tenant_key")
  @@index([operationalZoneId, operationalStatus, qualityStatus])
  @@index([tenantId])
  @@index([bakeryId, tenantId], map: "g3b_BakeryBranch_bakeryId_tenant_idx")
  @@index([cityId, tenantId], map: "g3b_BakeryBranch_cityId_tenant_idx")
  @@index([operationalZoneId, tenantId], map: "g3b_BakeryBranch_operationalZoneId_tenant_idx")
