/// One bookable delivery window at one branch.
///
/// Materialised the moment a customer prices a basket against it, rather than
/// generated ahead by a scheduled job: a window only needs to exist once
/// somebody wants it, and a table pre-filled two weeks out for every branch in
/// every city is a table that is wrong the day an operator changes the hours.
///
/// The row exists so the window's capacity can be claimed atomically. A count
/// of orders would be a read that is stale by the time it is acted on, and two
/// customers would both take the last slot of the seven o'clock batch.
model BakeryDeliveryWindow {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  bakeryBranchId String       @db.Uuid
  bakeryBranch   BakeryBranch @relation(fields: [bakeryBranchId], references: [id], onDelete: Cascade)
  /// The local calendar day this window belongs to, in the city's timezone.
  serviceDate    DateTime     @db.Date
  /// The window itself, as instants. Stored resolved rather than as local
  /// minutes so that everything downstream — the courier's deadline, the
  /// customer's notification — reads one unambiguous point in time.
  startsAt       DateTime
  endsAt         DateTime
  maxOrders      Int
  reservedOrders Int          @default(0)
  suspended      Boolean      @default(false)
  quotes         Quote[]
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([bakeryBranchId, startsAt])
  @@unique([id, tenantId], map: "g3b_BakeryDeliveryWindow_id_tenant_key")
  @@index([tenantId])
  @@index([bakeryBranchId, serviceDate])
  @@index([bakeryBranchId, tenantId], map: "g3b_BakeryDeliveryWindow_bakeryBranchId_tenant_idx")
}

