/// The text of one kind of message, for one tenant.
///
/// Unlike AuthDeliveryProviderConfiguration — whose fields are frozen at
/// creation because changing a credential reference or sender mid-flight would
/// silently repoint live traffic — a template is meant to be edited. Wording is
/// the operator's to change, and requiring a new provider configuration to fix
/// a typo would be absurd. What is frozen is the row's identity: which tenant
/// and which purpose it speaks for.
model MessageTemplate {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @db.Uuid
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channel     MessageChannel
  purpose     MessageTemplatePurpose
  body        String                 @db.VarChar(480)
  /// A disabled template stops its message being sent at all. The OTP purpose
  /// refuses to be disabled — see the database guard — because that would lock
  /// every customer out of the app from a settings page.
  enabled     Boolean                @default(true)
  version     Int                    @default(1)
  updatedById String?                @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, channel, purpose], map: "message_template_identity_key")
  @@unique([id, tenantId], map: "message_template_id_tenant_key")
  @@index([tenantId, channel], map: "message_template_tenant_channel_idx")
}

/// One message sent to one customer about one step of one order.
///
/// The unique key across tenant, order and purpose is the whole point: the
/// outbox publisher is at-least-once, so without it a publisher that sent a
/// message and then died before marking the event published would text the
/// customer again on the next sweep. Claiming this row is what makes the send
/// happen once.
model CustomerNotification {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @db.Uuid
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderId           String                    @db.Uuid
  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  channel           MessageChannel
  purpose           MessageTemplatePurpose
  state             CustomerNotificationState @default(PENDING)
  /// The message as sent. Kept because the template it came from is editable,
  /// so the template alone cannot answer what a customer actually received.
  body              String                    @db.VarChar(480)
  mobileE164        String                    @db.VarChar(16)
  templateVersion   Int                       @default(0)
  providerReference String?                   @db.VarChar(200)
  failureCode       String?                   @db.VarChar(64)
  attempts          Int                       @default(0)
  correlationId     String                    @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([tenantId, orderId, purpose], map: "customer_notification_identity_key")
  @@index([tenantId, state, createdAt], map: "customer_notification_state_idx")
  @@index([orderId, tenantId], map: "g3b_CustomerNotification_orderId_tenant_idx")
}

enum RouteDistanceSource {
  ROUTED
  ESTIMATED
}

enum RoutingEnvironment {
  TEST
  PRODUCTION
}

enum RoutingProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum EmailEnvironment {
  TEST
  PRODUCTION
}

enum EmailProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

/// Which service carries this tenant's email.
///
/// Shaped like the SMS and routing configurations because an operator already
/// knows that form: created in its final shape, and taken out of rotation by
/// marking it unhealthy rather than by a migration.
///
/// `env://` is allowed, as it is for routing and SMS and unlike payment: an
/// email credential sends messages, it does not move money. The `EMAIL_` prefix
/// is enforced for the same reason the others enforce theirs — so a
/// configuration cannot name an unrelated environment variable and hand its
/// value to an adapter.
///
/// The sender address is stored rather than referenced. It is not a secret, it
/// is printed on every message the tenant sends, and an operator debugging
/// "why does this land in spam" needs to read it without a database session.
model EmailProviderConfiguration {
  id                  String                    @id @default(uuid()) @db.Uuid
  tenantId            String                    @db.Uuid
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerCode        String                    @db.VarChar(32)
  adapterVersion      String                    @db.VarChar(64)
  adapterSpiVersion   Int                       @default(1)
  environment         EmailEnvironment
  credentialReference String                    @db.VarChar(255)
  senderAddress       String                    @db.VarChar(254)
  senderName          String                    @db.VarChar(128)
  enabled             Boolean                   @default(false)
  isDefault           Boolean                   @default(false)
  priority            Int                       @default(100)
  healthStatus        EmailProviderHealthStatus @default(UNKNOWN)
  governanceVersion   Int                       @default(1)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([tenantId, providerCode, environment, adapterVersion, adapterSpiVersion], map: "EmailProvider_tenant_code_environment_version_key")
  @@index([tenantId, environment, enabled, isDefault, priority], map: "EmailProvider_tenant_selection_idx")
}

enum RoutingProfile {
  MOTORCYCLE
  CAR
}

/// Which engine measures the road for this tenant.
///
/// Shaped like the SMS gateway configuration because an operator already knows
/// that form. `env://` is allowed here where payment credentials forbid it: a
/// routing key buys distances, not money, and the worst a leaked one does is
/// spend the tenant's routing quota.
model RoutingProviderConfiguration {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @db.Uuid
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerCode        String                      @db.VarChar(32)
  adapterVersion      String                      @db.VarChar(64)
  adapterSpiVersion   Int                         @default(1)
  environment         RoutingEnvironment
  credentialReference String                      @db.VarChar(255)
  enabled             Boolean                     @default(false)
  isDefault           Boolean                     @default(false)
  priority            Int                         @default(100)
  healthStatus        RoutingProviderHealthStatus @default(UNKNOWN)
  governanceVersion   Int                         @default(1)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([tenantId, providerCode, environment, adapterVersion, adapterSpiVersion], map: "RoutingProvider_tenant_code_environment_version_key")
  @@index([tenantId, environment, enabled, isDefault], map: "RoutingProvider_tenant_environment_enabled_idx")
}

/// What the engine said, kept so it is not asked twice.
///
/// Only routed distances live here. There is deliberately no row for a
/// straight-line estimate: caching a fallback would freeze it in place long
/// after routing recovered, turning a ten-minute outage into a fortnight of
/// guessed fares that nothing would ever correct.
model RouteEstimate {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bakeryBranchId       String         @db.Uuid
  bakeryBranch         BakeryBranch   @relation(fields: [bakeryBranchId], references: [id], onDelete: Restrict)
  /// Rounded to four places (about eleven metres) before storage, so a saved
  /// address ordered from twice produces the same key rather than missing on
  /// floating-point noise.
  destinationLatitude  Decimal        @db.Decimal(9, 4)
  destinationLongitude Decimal        @db.Decimal(9, 4)
  profile              RoutingProfile
  avoidTrafficZone     Boolean
  avoidOddEvenZone     Boolean
  /// Two engines disagree about the same road, so a cached distance belongs to
  /// the engine that produced it.
  providerCode         String         @db.VarChar(32)
  distanceMetres       Int
  durationSeconds      Int?
  computedAt           DateTime       @default(now())

  @@unique([tenantId, bakeryBranchId, destinationLatitude, destinationLongitude, profile, avoidTrafficZone, avoidOddEvenZone, providerCode], map: "RouteEstimate_lookup_key")
  @@index([tenantId, computedAt], map: "RouteEstimate_tenant_computed_idx")
  @@index([bakeryBranchId, tenantId], map: "g3b_RouteEstimate_bakeryBranchId_tenant_idx")
}

enum DeliveryTripState {
  PLANNED
  DISPATCHED
  COMPLETED
  CANCELLED
}

/// Several orders, one courier, one ride.
///
/// The ride out to a neighbourhood is paid once per trip rather than once per
/// loaf, which is the largest cost lever left in delivery. The risk it
/// introduces is that on a shared run the last customer waits for everyone
/// ahead of them — which is why the planner refuses far more batches than it
/// builds, and why the stops become immutable the moment a courier is offered
/// the run.
model DeliveryTrip {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// One pickup per run: a rider collecting from two bakeries is two rides with
  /// the loaves going cold in between.
  bakeryBranchId     String             @db.Uuid
  bakeryBranch       BakeryBranch       @relation(fields: [bakeryBranchId], references: [id], onDelete: Restrict)
  state              DeliveryTripState  @default(PLANNED)
  plannedDepartureAt DateTime
  plannedMetres      Int
  /// What this run saves against delivering each drop separately. Kept rather
  /// than recomputed, because a plan that has since changed would answer a
  /// different question.
  savedMetres        Int                @default(0)
  dispatchedAt       DateTime?
  completedAt        DateTime?
  correlationId      String             @db.Uuid
  version            Int                @default(1)
  stops              DeliveryTripStop[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([id, tenantId], map: "g3b_DeliveryTrip_id_tenant_key")
  @@index([tenantId, state, createdAt], map: "DeliveryTrip_tenant_state_idx")
  @@index([bakeryBranchId, tenantId], map: "g3b_DeliveryTrip_bakeryBranchId_tenant_idx")
}

/// One delivery's place in a run. A loaf rides once, and two drops cannot both
/// be third.
model DeliveryTripStop {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveryTripId   String       @db.Uuid
  deliveryTrip     DeliveryTrip @relation(fields: [deliveryTripId], references: [id], onDelete: Restrict)
  deliveryTaskId   String       @unique @db.Uuid
  deliveryTask     DeliveryTask @relation(fields: [deliveryTaskId], references: [id], onDelete: Restrict)
  sequence         Int
  legMetres        Int
  plannedArrivalAt DateTime
  createdAt        DateTime     @default(now())

  @@unique([tenantId, deliveryTaskId], map: "DeliveryTripStop_task_key")
  @@unique([deliveryTripId, sequence], map: "DeliveryTripStop_sequence_key")
  @@index([deliveryTripId, tenantId], map: "g3b_DeliveryTripStop_deliveryTripId_tenant_idx")
  @@index([deliveryTaskId, tenantId], map: "g3b_DeliveryTripStop_deliveryTaskId_tenant_idx")
}

/// A discount campaign.
///
/// `cityId` is the field that makes provincial and national rollout possible:
/// a campaign opened for one city cannot be spent by customers in another, so
/// one city's launch budget cannot be drained by a market it was never meant
/// for. Null means the campaign runs everywhere.
///
/// Percentages are basis points, never floats — a campaign that is a hundredth
/// of a Rial out is a ledger that will not reconcile.
model Promotion {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// What the customer types. Stored normalised: upper case, no separators.
  code                  String                @db.VarChar(64)
  nameFa                String
  kind                  PromotionKind
  percentageBasisPoints Int?
  fixedAmount           BigInt?
  maxDiscountAmount     BigInt?
  minSubtotalAmount     BigInt?
  currency              Currency              @default(IRR)
  startsAt              DateTime
  endsAt                DateTime?
  totalRedemptionLimit  Int?
  perCustomerLimit      Int?
  firstOrderOnly        Boolean               @default(false)
  cityId                String?               @db.Uuid
  city                  City?                 @relation(fields: [cityId], references: [id], onDelete: Restrict)
  isActive              Boolean               @default(false)
  /// Counted rather than derived, so the limit can be enforced by a conditional
  /// update instead of a scan that races under concurrency.
  redeemedCount         Int                   @default(0)
  redemptions           PromotionRedemption[]
  quotes                Quote[]
  orders                Order[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, code], map: "Promotion_tenant_code_key")
  @@unique([id, tenantId], map: "g3b_Promotion_id_tenant_key")
  @@index([tenantId, isActive, startsAt])
  @@index([cityId])
  @@index([cityId, tenantId], map: "g3b_Promotion_cityId_tenant_idx")
}

/// One customer's use of one campaign.
///
/// Held when a quote is cut and only spent when the order is accepted. Without
/// that distinction an abandoned basket would burn a redemption, and a campaign
/// capped at a thousand would be exhausted by people who never bought anything.
model PromotionRedemption {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @db.Uuid
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  promotionId   String                   @db.Uuid
  promotion     Promotion                @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  customerId    String                   @db.Uuid
  customer      Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId       String?                  @unique @db.Uuid
  quote         Quote?                   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId       String?                  @unique @db.Uuid
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// What it was worth, snapshotted. The campaign's terms may change later; what
  /// this customer was actually given must not.
  amount        BigInt
  basis         DiscountBasis
  currency      Currency                 @default(IRR)
  state         PromotionRedemptionState @default(RESERVED)
  correlationId String                   @db.Uuid
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([id, tenantId], map: "g3b_PromotionRedemption_id_tenant_key")
  @@index([tenantId, promotionId, customerId, state])
  @@index([promotionId, state])
  @@index([customerId])
  @@index([promotionId, tenantId], map: "g3b_PromotionRedemption_promotionId_tenant_idx")
  @@index([customerId, tenantId], map: "g3b_PromotionRedemption_customerId_tenant_idx")
  @@index([quoteId, tenantId], map: "g3b_PromotionRedemption_quoteId_tenant_idx")
  @@index([orderId, tenantId], map: "g3b_PromotionRedemption_orderId_tenant_idx")
}
