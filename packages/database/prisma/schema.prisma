generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  IRR
}

enum CustomerLifecycleStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum HouseholdMemberRole {
  OWNER
  ADULT
  DEPENDENT
  RECIPIENT
}

enum AddressVerificationState {
  UNVERIFIED
  CUSTOMER_CONFIRMED
  OPERATIONS_VERIFIED
  REJECTED
}

enum BakeryPartnerStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum BranchOperationalStatus {
  ONBOARDING
  ACTIVE
  TEMPORARILY_SUSPENDED
  CLOSED
}

enum QualityStatus {
  PENDING_REVIEW
  APPROVED
  WATCHLIST
  SUSPENDED
}

enum ProductFulfillmentClass {
  SIGNATURE_FRESH
  PACKAGED_TRADITIONAL
  PACKAGED_FANTASY
  PACKAGED_DIETARY
  LIMITED_EDITION
}

enum FreshnessClaim {
  FRESHLY_PRODUCED
  PACKAGED
  SHELF_STABLE
  NONE
}

enum ProductionMode {
  MADE_TO_ORDER
  SCHEDULED_BATCH
  READY_STOCK
  EXTERNAL_PACKAGED_SUPPLY
}

enum FulfillmentControl {
  CONTROLLED_PICKUP
  PARTNER_HANDOFF
  PLATFORM_STOCK
  THIRD_PARTY_SUPPLY
}

enum PackagingType {
  ALO_NOON_SEALED
  PARTNER_SEALED
  MANUFACTURER_PACKAGED
}

enum ProductLifecycleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

enum OfferingAvailabilityStatus {
  DRAFT
  AVAILABLE
  PAUSED
  SOLD_OUT
  RETIRED
}

enum OrderState {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  IN_FULFILLMENT
  CANCEL_REQUESTED
  DELIVERY_FAILED
  COMPLETED
  CANCELLED
}

enum PaymentState {
  NOT_STARTED
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
}

enum ProductionState {
  NOT_REQUIRED
  UNSCHEDULED
  SCHEDULED
  IN_PRODUCTION
  READY
  HANDED_OFF
}

enum DeliveryState {
  NOT_REQUIRED
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ActorType {
  CUSTOMER
  STAFF
  BAKERY
  COURIER
  SYSTEM
}

enum FulfillmentType {
  BAKERY_PICKUP_DELIVERY
  PLATFORM_STOCK_DELIVERY
  CUSTOMER_PICKUP
}

enum FulfillmentState {
  PLANNED
  PREPARING
  READY
  HANDED_OFF
  COMPLETED
  FAILED
  CANCELLED
}

enum CourierStatus {
  ONBOARDING
  AVAILABLE
  UNAVAILABLE
  SUSPENDED
  OFFBOARDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  ELECTRIC_MOTORCYCLE
  CAR
  VAN
  ON_FOOT
}

enum VehicleStatus {
  PENDING_REVIEW
  ACTIVE
  MAINTENANCE
  SUSPENDED
  RETIRED
}

enum DeliveryTaskState {
  UNASSIGNED
  ASSIGNMENT_PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryAssignmentState {
  OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EventPurpose {
  DOMAIN
  AUDIT
  ENGAGEMENT
}

enum ConsentBasis {
  NOT_REQUIRED
  TRANSACTIONAL
  EXPLICIT_CONSENT
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IncidentStatus {
  OPEN
  MITIGATING
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IdentityAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OtpChallengeStatus {
  PENDING
  CONSUMED
  INVALIDATED
}

enum AuthDeliveryEnvironment {
  TEST
  PRODUCTION
}

enum MessageChannel {
  SMS
}

enum CustomerNotificationState {
  PENDING
  SENT
  FAILED
  /// The tenant switched this message off, or the order has no reachable phone.
  /// Recorded rather than skipped silently so "why did nobody get a text" has
  /// an answer.
  SUPPRESSED
}

enum MessageTemplatePurpose {
  AUTH_OTP
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_COMPLETED
  ORDER_CANCELLED
}

enum AuthProviderHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum AuthOtpChallengeStatus {
  PREPARED
  DELIVERED
  DELIVERY_UNKNOWN
  FAILED
  CONSUMED
  INVALIDATED
  EXPIRED
}

enum AuthDeliveryAttemptStatus {
  INITIALIZED
  DELIVERED
  REJECTED
  TRANSIENT_FAILURE
  PERMANENT_FAILURE
  UNKNOWN
}

enum AuthAbuseAction {
  OTP_REQUEST
  OTP_VERIFY_FAILURE
}

enum AuthorizationScopeType {
  GLOBAL
  CITY
  OPERATIONAL_ZONE
  BAKERY_BRANCH
  COURIER_PARTNER
  SELF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TenantMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CartState {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum QuoteStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  ACCEPTED
}

enum DeliveryPricingCalculationMode {
  FLAT
  DISTANCE_BANDED
}

enum PaymentAggregateState {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum FinancialTransactionType {
  PAYMENT_CAPTURE
  PAYMENT_REFUND
  /// A courier handing in the cash they collected. Not a payment event — the
  /// order was already paid when the notes changed hands — but a movement of
  /// the same money from a courier's pocket into the bank.
  CASH_REMITTANCE
}

/// How an order is paid for.
enum PaymentMethod {
  ONLINE_GATEWAY
  CASH_ON_DELIVERY
}

enum LedgerAccountGovernanceAction {
  PROVISIONED
  ACTIVATED
  DEACTIVATED
}

enum PaymentProviderEnvironment {
  TEST
  PRODUCTION
}

enum PromotionKind {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum DiscountBasis {
  SUBTOTAL
  DELIVERY_FEE
}

/// A redemption is held while a quote is alive and only spent when an order is
/// accepted, so an abandoned checkout cannot consume a campaign's budget.
enum PromotionRedemptionState {
  RESERVED
  CONSUMED
  RELEASED
}

enum PaymentProviderCapability {
  PAYMENT_INITIALIZATION
  CALLBACK_VERIFICATION
  PAYMENT_INQUIRY
  CANCELLATION
  REFUND
}

enum PaymentContext {
  CHECKOUT
}

enum ProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum PaymentProviderGovernanceAction {
  CREATED
  ACTIVATED
  DEACTIVATED
}

enum PaymentAttemptState {
  CREATED
  INITIALIZATION_PENDING
  INITIALIZED
  CUSTOMER_ACTION_REQUIRED
  CALLBACK_RECEIVED
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
  FAILED
  EXPIRED
}

enum PaymentInitializationOutcome {
  ACCEPTED
  CUSTOMER_ACTION_REQUIRED
  REJECTED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  UNKNOWN
}

enum PaymentCallbackVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum PaymentCallbackProcessingStatus {
  RECEIVED
  PROCESSED
  REJECTED
}

model Tenant {
  id                                 String                              @id @default(uuid()) @db.Uuid
  slug                               String                              @unique @db.VarChar(64)
  name                               String
  status                             TenantStatus                        @default(ACTIVE)
  defaultLocale                      String                              @default("fa-IR") @db.VarChar(16)
  currency                           Currency                            @default(IRR)
  domains                            TenantDomain[]
  memberships                        TenantMembership[]
  activeSessions                     AuthSession[]
  deliveryPricingRules               DeliveryPricingRule[]
  aiAuditEvents                      AiControlPlaneAuditEvent[]
  authDeliveryProviderConfigurations AuthDeliveryProviderConfiguration[]
  authOtpChallenges                  AuthOtpChallenge[]
  authDeliveryAttempts               AuthOtpDeliveryAttempt[]
  authAbuseEvents                    AuthAbuseEvent[]
  messageTemplates                   MessageTemplate[]
  customerNotifications              CustomerNotification[]
  routingProviderConfigurations      RoutingProviderConfiguration[]
  emailProviderConfigurations        EmailProviderConfiguration[]
  routeEstimates                     RouteEstimate[]
  deliveryTrips                      DeliveryTrip[]
  deliveryTripStops                  DeliveryTripStop[]
  promotions                         Promotion[]
  promotionRedemptions               PromotionRedemption[]
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt

  @@index([status, createdAt])
}

model TenantDomain {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host       String    @unique @db.VarChar(253)
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, isPrimary])
}

model TenantMembership {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @db.Uuid
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId   String                 @db.Uuid
  account     IdentityAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId  String?                @db.Uuid
  customer    Customer?              @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  status      TenantMembershipStatus @default(INVITED)
  activeAt    DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, accountId])
  @@unique([tenantId, customerId])
  @@index([customerId, tenantId])
  @@index([accountId, status])
  @@index([tenantId, status])
}

model City {
  id                          String                @id @default(uuid()) @db.Uuid
  tenantId                    String                @db.Uuid
  code                        String                @unique @db.VarChar(32)
  nameFa                      String
  timezone                    String                @default("Asia/Tehran") @db.VarChar(64)
  isActive                    Boolean               @default(false)
  /// Whether this city takes cash at the door.
  ///
  /// Per city rather than per tenant because it is a market decision, not a
  /// product one: a launch city where nobody knows the brand yet may need cash
  /// to sell anything, and an established one may be ready to stop carrying
  /// the risk. Off by default — taking cash is a deliberate act.
  cashOnDeliveryEnabled       Boolean               @default(false)
  /// The most an order may be worth and still be payable in cash. Null is
  /// uncapped, which an operator should have to choose.
  cashOnDeliveryCeiling       BigInt?
  /// Completed orders a customer needs before cash is offered to them. Zero
  /// offers it to anyone, which suits a bakery that knows its neighbourhood
  /// and does not suit a city launch.
  cashOnDeliveryMinimumOrders Int                   @default(0)
  operationalZones            OperationalZone[]
  addresses                   Address[]
  bakeryBranches              BakeryBranch[]
  carts                       Cart[]
  orders                      Order[]
  deliveryPricingRules        DeliveryPricingRule[]
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  promotions                  Promotion[]

  @@unique([id, tenantId], map: "g3b_City_id_tenant_key")
  @@index([tenantId])
}

model OperationalZone {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  cityId               String                @db.Uuid
  city                 City                  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  code                 String                @db.VarChar(32)
  nameFa               String
  isActive             Boolean               @default(false)
  serviceAreas         ServiceArea[]
  addresses            Address[]
  bakeryBranches       BakeryBranch[]
  orders               Order[]
  carts                Cart[]
  deliveryPricingRules DeliveryPricingRule[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([cityId, code])
  @@unique([id, tenantId], map: "g3b_OperationalZone_id_tenant_key")
  @@index([cityId, isActive])
  @@index([tenantId])
  @@index([cityId, tenantId], map: "g3b_OperationalZone_cityId_tenant_idx")
}

model ServiceArea {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  operationalZoneId String          @db.Uuid
  operationalZone   OperationalZone @relation(fields: [operationalZoneId], references: [id], onDelete: Cascade)
  code              String          @db.VarChar(32)
  nameFa            String
  boundaryGeoJson   Json
  isActive          Boolean         @default(false)
  addresses         Address[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([operationalZoneId, code])
  @@unique([id, tenantId], map: "g3b_ServiceArea_id_tenant_key")
  @@index([operationalZoneId, isActive])
  @@index([tenantId])
  @@index([operationalZoneId, tenantId], map: "g3b_ServiceArea_operationalZoneId_tenant_idx")
}

model Customer {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  mobileE164             String                  @db.VarChar(16)
  firstName              String?
  lastName               String?
  lifecycleStatus        CustomerLifecycleStatus @default(PROSPECT)
  crmProfileRef          String?                 @unique @db.VarChar(128)
  transactionalConsentAt DateTime?
  marketingConsentAt     DateTime?
  marketingOptOutAt      DateTime?
  householdMemberships   HouseholdMember[]
  addresses              Address[]
  orders                 Order[]
  payments               Payment[]
  customerEvents         CustomerEvent[]
  supportCases           SupportCase[]
  identityAccount        IdentityAccount?
  tenantMemberships      TenantMembership[]
  carts                  Cart[]
  quotes                 Quote[]
  ratings                OrderRating[]
  favourites             CustomerFavourite[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  promotionRedemptions   PromotionRedemption[]

  @@unique([id, tenantId], map: "g3b_Customer_id_tenant_key")
  @@unique([tenantId, mobileE164], map: "auth_Customer_tenant_mobile_key")
  @@index([lifecycleStatus, createdAt])
  @@index([tenantId])
}

model IdentityAccount {
  id                String                @id @default(uuid()) @db.Uuid
  mobileE164        String                @unique @db.VarChar(16)
  customerId        String?               @unique @db.Uuid
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status            IdentityAccountStatus @default(ACTIVE)
  verifiedAt        DateTime?
  sessions          AuthSession[]
  accessGrants      AccessGrant[]
  tenantMemberships TenantMembership[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, createdAt])
}

model OtpChallenge {
  id                String             @id @default(uuid()) @db.Uuid
  mobileE164        String             @db.VarChar(16)
  codeDigest        String             @db.VarChar(64)
  status            OtpChallengeStatus @default(PENDING)
  attempts          Int                @default(0)
  maxAttempts       Int                @default(5)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime           @default(now())

  @@index([mobileE164, createdAt])
  @@index([status, expiresAt])
}

model AuthDeliveryProviderConfiguration {
  id                  String                   @id @default(uuid()) @db.Uuid
  tenantId            String                   @db.Uuid
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerCode        String                   @db.VarChar(32)
  adapterVersion      String                   @db.VarChar(64)
  adapterSpiVersion   Int                      @default(1)
  environment         AuthDeliveryEnvironment
  credentialReference String                   @unique @db.VarChar(255)
  senderReference     String                   @db.VarChar(128)
  templateReference   String                   @db.VarChar(128)
  enabled             Boolean                  @default(false)
  isDefault           Boolean                  @default(false)
  priority            Int                      @default(100)
  healthStatus        AuthProviderHealthStatus @default(HEALTHY)
  consecutiveFailures Int                      @default(0)
  circuitOpenedUntil  DateTime?
  governanceVersion   Int                      @default(1)
  deliveryAttempts    AuthOtpDeliveryAttempt[]
  abuseEvents         AuthAbuseEvent[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([tenantId, providerCode, environment, adapterVersion], map: "auth_provider_identity_key")
  @@unique([id, tenantId], map: "auth_provider_id_tenant_key")
  @@index([tenantId, environment, enabled, isDefault, priority], map: "auth_provider_selection_idx")
  @@index([tenantId, circuitOpenedUntil], map: "auth_provider_circuit_idx")
}

model AuthOtpChallenge {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @db.Uuid
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mobileE164            String                  @db.VarChar(16)
  mobileDigest          String                  @db.VarChar(64)
  codeDigest            String                  @db.VarChar(64)
  requestIdempotencyKey String                  @db.VarChar(128)
  requestFingerprint    String                  @db.VarChar(64)
  sourceIpDigest        String                  @db.VarChar(64)
  status                AuthOtpChallengeStatus  @default(PREPARED)
  attempts              Int                     @default(0)
  maxAttempts           Int                     @default(5)
  expiresAt             DateTime
  resendAvailableAt     DateTime
  consumedAt            DateTime?
  invalidatedAt         DateTime?
  supersededAt          DateTime?
  correlationId         String                  @db.Uuid
  version               Int                     @default(1)
  deliveryAttempt       AuthOtpDeliveryAttempt?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([tenantId, requestIdempotencyKey], map: "auth_challenge_idempotency_key")
  @@unique([id, tenantId], map: "auth_challenge_id_tenant_key")
  @@index([tenantId, mobileDigest, createdAt], map: "auth_challenge_mobile_idx")
  @@index([tenantId, status, expiresAt], map: "auth_challenge_cleanup_idx")
}

model AuthOtpDeliveryAttempt {
  id                      String                            @id @default(uuid()) @db.Uuid
  tenantId                String                            @db.Uuid
  tenant                  Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  challengeId             String                            @unique @db.Uuid
  challenge               AuthOtpChallenge                  @relation(fields: [challengeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerConfigurationId String                            @db.Uuid
  providerConfiguration   AuthDeliveryProviderConfiguration @relation(fields: [providerConfigurationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  state                   AuthDeliveryAttemptStatus         @default(INITIALIZED)
  requestFingerprint      String                            @db.VarChar(64)
  providerReference       String?                           @db.VarChar(200)
  safeFailureCode         String?                           @db.VarChar(64)
  correlationId           String                            @db.Uuid
  startedAt               DateTime
  finalizedAt             DateTime?
  version                 Int                               @default(1)
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@unique([id, tenantId], map: "auth_attempt_id_tenant_key")
  @@unique([challengeId, tenantId], map: "auth_attempt_challenge_tenant_key")
  @@unique([tenantId, providerConfigurationId, providerReference], map: "auth_attempt_provider_reference_key")
  @@index([tenantId, state, startedAt], map: "auth_attempt_recovery_idx")
  @@index([providerConfigurationId, tenantId], map: "auth_attempt_provider_tenant_idx")
}

model AuthAbuseEvent {
  id                      String                             @id @default(uuid()) @db.Uuid
  tenantId                String                             @db.Uuid
  tenant                  Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  action                  AuthAbuseAction
  mobileDigest            String?                            @db.VarChar(64)
  sourceIpDigest          String?                            @db.VarChar(64)
  providerConfigurationId String?                            @db.Uuid
  providerConfiguration   AuthDeliveryProviderConfiguration? @relation(fields: [providerConfigurationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  occurredAt              DateTime
  expiresAt               DateTime
  createdAt               DateTime                           @default(now())

  @@index([tenantId, action, occurredAt], map: "auth_abuse_tenant_window_idx")
  @@index([tenantId, mobileDigest, action, occurredAt], map: "auth_abuse_mobile_window_idx")
  @@index([tenantId, sourceIpDigest, action, occurredAt], map: "auth_abuse_ip_window_idx")
  @@index([providerConfigurationId, tenantId, action, occurredAt], map: "auth_abuse_provider_window_idx")
  @@index([expiresAt], map: "auth_abuse_cleanup_idx")
}

model AuthSession {
  id             String          @id @default(uuid()) @db.Uuid
  accountId      String          @db.Uuid
  account        IdentityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activeTenantId String          @db.Uuid
  activeTenant   Tenant          @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)
  tokenDigest    String          @unique @db.VarChar(64)
  expiresAt      DateTime
  lastSeenAt     DateTime
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([accountId, revokedAt, expiresAt])
}

model AuthorizationRole {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String
  permissions RolePermission[]
  grants      AccessGrant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model AuthorizationPermission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String                  @db.Uuid
  role         AuthorizationRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String                  @db.Uuid
  permission   AuthorizationPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AccessGrant {
  id        String                 @id @default(uuid()) @db.Uuid
  accountId String                 @db.Uuid
  account   IdentityAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roleId    String                 @db.Uuid
  role      AuthorizationRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType AuthorizationScopeType
  scopeId   String?                @db.Uuid
  activeAt  DateTime               @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([accountId, revokedAt, expiresAt])
  @@index([scopeType, scopeId])
}

model Household {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  name      String
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([id, tenantId], map: "g3b_Household_id_tenant_key")
  @@index([tenantId])
}

model HouseholdMember {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  householdId String              @db.Uuid
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  customerId  String?             @db.Uuid
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  displayName String
  mobileE164  String?             @db.VarChar(16)
  role        HouseholdMemberRole
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([householdId, customerId])
  @@index([householdId, role])
  @@index([tenantId])
