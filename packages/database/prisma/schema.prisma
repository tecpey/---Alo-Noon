/// A courier handing in the cash they collected.
///
/// The header of the act: which courier, how much they were expected to bring,
/// how much they actually handed over, and who counted it. The individual
/// orders hang off it, and each one posts its own journal — an order's cash can
/// be handed in exactly once, which is the invariant that matters when someone
/// is standing at a desk with a bag of notes.
model CourierCashRemittance {
  id             String                      @id @default(uuid()) @db.Uuid
  tenantId       String                      @db.Uuid
  courierId      String                      @db.Uuid
  courier        Courier                     @relation(fields: [courierId], references: [id], onDelete: Restrict)
  /// Derived from the orders being settled, never typed in.
  expectedAmount BigInt
  /// What was actually counted onto the desk.
  declaredAmount BigInt
  currency       Currency                    @default(IRR)
  /// The staff account that counted it. A remittance nobody signed for is a
  /// remittance nobody can be asked about. Unconstrained, like every other
  /// actor id here: identity accounts are not tenant-owned.
  countedById    String                      @db.Uuid
  idempotencyKey String                      @db.VarChar(128)
  correlationId  String                      @db.Uuid
  occurredAt     DateTime
  items          CourierCashRemittanceItem[]
  createdAt      DateTime                    @default(now())

  @@unique([tenantId, idempotencyKey], map: "CourierCashRemittance_tenant_idempotency_key")
  @@unique([id, tenantId], map: "g3b_CourierCashRemittance_id_tenant_key")
  @@index([courierId, tenantId], map: "g3b_CourierCashRemittance_courierId_tenant_idx")
  @@index([tenantId, occurredAt])
}

/// One order's cash inside a remittance.
model CourierCashRemittanceItem {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @db.Uuid
  remittanceId String                @db.Uuid
  remittance   CourierCashRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  orderId      String                @db.Uuid
  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId    String                @db.Uuid
  payment      Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// Snapshotted from the payment. What the courier was carrying for this
  /// order does not change because something was edited afterwards.
  amount       BigInt
  createdAt    DateTime              @default(now())

  /// An order's cash belongs to one remittance. The ledger enforces the same
  /// thing through the unique posting per payment; this says it where an
  /// operator can be told about it before any money moves.
  @@unique([tenantId, orderId], map: "CourierCashRemittanceItem_tenant_order_key")
  @@unique([id, tenantId], map: "g3b_CourierCashRemittanceItem_id_tenant_key")
  @@index([remittanceId, tenantId], map: "g3b_CourierCashRemittanceItem_remittanceId_tenant_idx")
  @@index([orderId, tenantId], map: "g3b_CourierCashRemittanceItem_orderId_tenant_idx")
  @@index([paymentId, tenantId], map: "g3b_CourierCashRemittanceItem_paymentId_tenant_idx")
}

