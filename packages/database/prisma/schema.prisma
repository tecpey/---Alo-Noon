model Quote {
  id                                String                @id @default(uuid()) @db.Uuid
  tenantId                          String                @db.Uuid
  publicId                          String                @unique @default(cuid()) @db.VarChar(32)
  idempotencyKey                    String                @db.VarChar(128)
  cartId                            String                @db.Uuid
  cart                              Cart                  @relation(fields: [cartId], references: [id], onDelete: Restrict)
  customerId                        String                @db.Uuid
  customer                          Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cartVersion                       Int
  status                            QuoteStatus           @default(ACTIVE)
  expiresAt                         DateTime
  subtotalAmount                    BigInt
  deliveryFeeAmount                 BigInt                @default(0)
  discountAmount                    BigInt                @default(0)
  totalAmount                       BigInt
  currency                          Currency              @default(IRR)
  deliveryAddressId                 String?               @db.Uuid
  deliveryAddress                   Address?              @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  deliveryPricingRuleId             String?               @db.Uuid
  deliveryPricingRule               DeliveryPricingRule?  @relation(fields: [deliveryPricingRuleId], references: [id], onDelete: Restrict)
  deliveryPricingRuleVersion        Int?
  deliveryServiceAreaIdSnapshot     String?               @db.Uuid
  deliveryOperationalZoneIdSnapshot String?               @db.Uuid
  deliveryDistanceMeters            Int?
  /// Whether the distance above was measured on the road network or inferred
  /// from the straight line. Null on quotes written before routing existed.
  deliveryDistanceSource            RouteDistanceSource?
  /// Why the distance is an estimate. Set only when the source is ESTIMATED,
  /// so its presence alone answers "what went wrong when this was priced?".
  deliveryDistanceReasonCode        String?               @db.VarChar(64)
  bakeryNameSnapshot                String?
  bakeryPickupSnapshot              String?
  recipientNameSnapshot             String?
  recipientPhoneSnapshot            String?               @db.VarChar(16)
  deliveryAddressSnapshot           String?
  deliveryLatitudeSnapshot          Decimal?              @db.Decimal(10, 7)
  deliveryLongitudeSnapshot         Decimal?              @db.Decimal(10, 7)
  deliveryInstructionsSnapshot      String?
  promotionId                       String?               @db.Uuid
  promotion                         Promotion?            @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  /// The delivery window the customer chose, when they chose one. Null means
  /// "as soon as you can", which is what every order was before windows existed.
  deliveryWindowId                  String?               @db.Uuid
  deliveryWindow                    BakeryDeliveryWindow? @relation(fields: [deliveryWindowId], references: [id], onDelete: Restrict)
  /// How the customer said they would pay. Recorded on the quote because the
  /// choice is made while pricing and the order must not have to guess it.
  paymentMethod                     PaymentMethod         @default(ONLINE_GATEWAY)
  promotionRedemption               PromotionRedemption?
  items                             QuoteItem[]
  order                             Order?
  createdAt                         DateTime              @default(now())
  updatedAt                         DateTime              @updatedAt

  @@unique([tenantId, customerId, idempotencyKey], map: "Quote_tenant_customer_idempotency_key")
  @@unique([id, tenantId], map: "g3b_Quote_id_tenant_key")
  @@index([customerId, status, expiresAt])
  @@index([cartId, cartVersion, status])
  @@index([deliveryAddressId])
  @@index([deliveryPricingRuleId])
  @@index([deliveryAddressId, tenantId], map: "g3b_Quote_deliveryAddressId_tenant_idx")
  @@index([promotionId, tenantId], map: "g3b_Quote_promotionId_tenant_idx")
  @@index([deliveryWindowId, tenantId], map: "g3b_Quote_deliveryWindowId_tenant_idx")
  @@index([deliveryPricingRuleId, tenantId], map: "g3b_Quote_deliveryPricingRuleId_tenant_idx")
  @@index([tenantId])
  @@index([cartId, tenantId], map: "g3b_Quote_cartId_tenant_idx")
  @@index([customerId, tenantId], map: "g3b_Quote_customerId_tenant_idx")
}

