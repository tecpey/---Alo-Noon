NODE_ENV=development
API_PORT=3001
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
DATABASE_URL=postgresql://alo_noon:alo_noon@localhost:5432/alo_noon?schema=public
# Generate independent values with a secrets manager; required in production.
AUTH_OTP_PEPPER=
AUTH_SESSION_PEPPER=
AUTH_ABUSE_PEPPER=
# Number of explicitly trusted reverse-proxy hops. Keep 0 unless deployment topology is verified.
API_TRUST_PROXY_HOPS=0
# Future approved adapters resolve opaque references such as env://AUTH_SMS_PROVIDER_API_KEY.
# Never commit the referenced value.
AUTH_SMS_PROVIDER_API_KEY=
# Optional. Error reporting stays fully disabled until this is set.
SENTRY_DSN=
# Public base URL payment provider adapters use to build each gateway's callback URL.
PAYMENT_CALLBACK_BASE_URL=http://localhost:3001
