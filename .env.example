NODE_ENV=development
API_PORT=3001
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
DATABASE_URL=postgresql://alo_noon:alo_noon@localhost:5432/alo_noon?schema=public
# Generate independent values with a secrets manager; required in production.
AUTH_OTP_PEPPER=
AUTH_SESSION_PEPPER=
AUTH_ABUSE_PEPPER=
# Number of trusted reverse-proxy hops in front of the API. Required in production:
# rate limiting and OTP abuse control key on the client IP, so leaving this at 0
# behind a load balancer puts every user in one shared bucket. Use 0 only when the
# API is exposed directly.
API_TRUST_PROXY_HOPS=0
# OTP delivery credentials. The database stores only the opaque reference
# (env://AUTH_SMS_LIMOSMS_KEY); the key itself lives here and is never committed.
# The variable name must match the reference the SMS configuration was created
# with, and every such reference has to start with AUTH_SMS_.
AUTH_SMS_LIMOSMS_KEY=
# Optional. Error reporting stays fully disabled until this is set.
SENTRY_DSN=
# Public base URL payment provider adapters use to build each gateway's callback URL.
PAYMENT_CALLBACK_BASE_URL=http://localhost:3001
# Where the customer lands after returning from the gateway. Carries no payment
# verdict; the callback route is registered only when this is set.
PAYMENT_RESULT_REDIRECT_URL=http://localhost:3000/payments/result
# Base64 32-byte key that opens local-encrypted:// payment credentials. Generate
# with: pnpm --filter @alo-noon/api provision generate-encryption-key
# Keep it somewhere other than the encrypted values below, or encryption is moot.
PAYMENT_SECRET_ENCRYPTION_KEY=
# One per gateway: a local-encrypted://IDPAY reference reads PAYMENT_SECRET_IDPAY.
# Store the ciphertext from `provision encrypt-payment-secret`, never the raw key.
PAYMENT_SECRET_IDPAY=
# Zarinpal's credential is its merchant id, encrypted the same way:
# {"merchantId":"<uuid from the Zarinpal panel>"}
PAYMENT_SECRET_ZARINPAL=
# Gateway origin the Zarinpal adapter talks to, keeping Zarinpal's own paths.
# Leave empty and a TEST configuration uses Zarinpal's real sandbox while a
# PRODUCTION one uses the live gateway — which is what both want. Set it only to
# point at a stand-in when the sandbox is unreachable from your network:
#   pnpm --filter @alo-noon/api exec tsx scripts/zarinpal-sandbox.ts
# Never set this in production.
PAYMENT_ZARINPAL_ENDPOINT=
# Zibal's credential is its merchant key: {"merchant":"<key from the Zibal panel>"}
PAYMENT_SECRET_ZIBAL=
# Zibal publishes no separate sandbox host — one set of endpoints serves both
# environments — so this override is the only way to exercise it without a live
# merchant. Leave empty in production.
PAYMENT_ZIBAL_ENDPOINT=
# Where the admin panel reaches the API. Must carry the TENANT's host, not an
# internal address: the API resolves the tenant from the host a request arrives
# on, and Node's fetch will not let the panel override the Host header. Point
# this at 127.0.0.1 and no tenant resolves, so the panel loops back to login.
ADMIN_API_BASE_URL=http://localhost:3001
